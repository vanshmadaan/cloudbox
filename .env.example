# Environment & App Settings
PROJECT_NAME="Cloud Storage Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (RDS / Local)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://clouduser:vnsh77@localhost:5432/cloudstorage"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True

# User Quota Limits (default: 100MB in bytes)
DEFAULT_STORAGE_QUOTA_BYTES=104857600

# AWS S3 Object Storage Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_BUCKET_NAME="my-cloud-storage-bucket"
S3_PRESIGNED_EXPIRATION_SECONDS=3600
S3_ENDPOINT_URL="" # Optional custom endpoint for LocalStack or MinIO e.g. http://localhost:4566

# AWS SQS Configuration (Background Task Queue)
SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/cloud-storage-tasks"
SQS_ENDPOINT_URL="" # Optional custom endpoint for LocalStack e.g. http://localhost:4566

# Storage Backend Mode: "s3" or "local" (fallback for testing without AWS)
STORAGE_BACKEND="s3"
LOCAL_STORAGE_DIR="./data/storage"

# CORS Configuration (comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

